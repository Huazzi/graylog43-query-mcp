# Copy this file to .env for local use. .env is gitignored; never commit it.
GRAYLOG_TST_BASE_URL=http://graylog.example.internal:9000
GRAYLOG_TST_TOKEN=replace-with-a-read-only-api-token
GRAYLOG_TST_PRECISION_STREAM_ID=replace-with-a-stream-id
GRAYLOG_TST_WORKFLOW_STREAM_ID=replace-with-a-stream-id

GRAYLOG_PRD_BASE_URL=http://graylog.example.internal:9000
GRAYLOG_PRD_TOKEN=replace-with-a-read-only-api-token
GRAYLOG_PRD_PRECISION_STREAM_ID=replace-with-a-stream-id
GRAYLOG_PRD_WORKFLOW_STREAM_ID=replace-with-a-stream-id

# 诊断日志级别：debug / info / warn / error，缺省 warn。
# warn 输出配置错误与请求失败；info 额外输出启动摘要与下载进度；debug 额外输出每次请求详情。
# 日志写入 stderr（MCP 协议只占用 stdout），不会包含 Token 或消息内容。
GRAYLOG_LOG_LEVEL=warn
